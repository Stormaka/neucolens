PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
# Optional: enables genuine LLM feedback and assignment chat.
GEMINI_API_KEY=
# Optional persistent SQLite location on Render/VM.
DATABASE_PATH=backend/db/skillslab.db
# Disabled in production by default because native code execution requires isolation.
ENABLE_LOCAL_RUNNER=false
# Chỉ bật để tạo tài khoản/lớp/bài tập minh họa ở môi trường demo.
SEED_DEMO_DATA=false

# Phase 2: LLM-as-a-Judge rubric scoring (mixed-initiative). Set false to disable entirely.
LLM_JUDGE_ENABLED=true
# Optional fallback judge provider.
DEEPSEEK_API_KEY=
# Frontend (Vite) — đặt trong frontend/.env hoặc .env
VITE_API_URL=http://localhost:3001/api
VITE_ENABLE_DEMO_LOGIN=false
# Render/Production
# FRONTEND_URL phải là origin chính xác của frontend (ví dụ https://your-app.vercel.app)
# SEED_DEMO_DATA=false trong production (chỉ true cho demo)
# DATABASE_PATH=/var/data/skillslab.db khi dùng Render Disk
